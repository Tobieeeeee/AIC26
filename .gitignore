# Raw/derived media and large artifacts
# Keep only .gitkeep placeholders.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/keyframes/*
!artifacts/keyframes/.gitkeep
artifacts/embeddings/*
!artifacts/embeddings/.gitkeep
artifacts/indexes/*
!artifacts/indexes/.gitkeep
artifacts/metrics/*
!artifacts/metrics/.gitkeep
artifacts/verification/*
!artifacts/verification/.gitkeep
artifacts/processed_*/
# Q&A prompt/answer batches: derived from competition data, never committed.
# Glob the whole family so a new run directory (qna_v2, qna_2026-08-20, ...)
# cannot silently start tracking competition-derived prompts.
artifacts/qna*/*
!artifacts/qna/.gitkeep
# The canonical keyframe mapping is generated, not authored: 14.5 MB, and
# every image_path is absolute on the machine that built it, so a committed
# copy would point at directories no teammate has. Regenerate in ~11s with
# `python scripts/build_keyframe_mapping.py --dataset-root <your root>`.
artifacts/keyframe_mapping.csv

