# =====================================================
# AIC26 MVR — Environment Variable Reference
# =====================================================
# Copy this file to .env and fill in real values. Never commit .env.
#
#   Windows PowerShell:   Copy-Item .env.example .env
#   macOS/Linux:          cp .env.example .env
#
# All values below are grouped by subsystem. Credentials (R2, DeepL, HF)
# are required only for the subsystems that use them.


# -------------------------------------------------------
# Cloudflare R2 — object storage for corpus/videos/features
# -------------------------------------------------------
# Account ID is the 32-char hex ID in your R2 overview page.
# Endpoint is one of:
#   https://<account_id>.r2.cloudflarestorage.com
#   https://<custom-domain>  (if you configured a public R2 domain)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=


# -------------------------------------------------------
# R2 sync layout overrides (optional)
# -------------------------------------------------------
# By default the sync layer uses the canonical layout in
# src/mvr/operations/r2_layout.py (data/raw, data/corpus, data/staging).
# Override only if your bucket uses a different prefix.
R2_RAW_PREFIX=data/raw
R2_CORPUS_PREFIX=data/corpus
R2_STAGING_PREFIX=data/staging

# Local cache / download root for R2 objects.
R2_LOCAL_ROOT=.
R2_CACHE_DIR=.cache/mvr
R2_CACHE_MAX_GB=50


# -------------------------------------------------------
# Local AIC dataset (videos/keyframes/map_keyframes)
# -------------------------------------------------------
# Point MVR_AIC_DATASET_ROOT at a local folder containing:
#   videos/
#   keyframes/<video_id>/
#   map_keyframes/<video_id>.csv
MVR_AIC_DATASET_ROOT=
MVR_VIDEO_ROOT=
MVR_KEYFRAME_ROOT=
MVR_KEYFRAME_MAPPING_CSV=
MVR_KEYFRAME_DIR=


# -------------------------------------------------------
# Semantic backend (Milvus is production; FAISS is reference)
# -------------------------------------------------------
MVR_SEMANTIC_BACKEND=milvus
# Path to a persisted FAISS semantic index (only for faiss_reference mode).
MVR_SEMANTIC_INDEX=
MVR_DEVICE=cuda


# -------------------------------------------------------
# Milvus — production vector index
# -------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=aic26_keyframes
MILVUS_URI=
MVR_MILVUS_INDEX_TYPE=HNSW
MVR_MILVUS_MANIFEST=


# -------------------------------------------------------
# Elasticsearch — lexical / BM25 / object / hybrid
# -------------------------------------------------------
MVR_ES_URL=http://localhost:9200
MVR_ES_INDEX=keyframes
MVR_ES_LEXICAL_INDEX=keyframes


# -------------------------------------------------------
# Embedding providers — local checkpoint paths
# -------------------------------------------------------
MVR_EMBEDDING_PROVIDER_SPECS=configs/embedding_providers.json
MVR_BEIT3_CHECKPOINT=
MVR_BEIT3_TOKENIZER=
MVR_METACLIP2_MODEL=
MVR_METACLIP2_ALLOW_DOWNLOAD=false
MVR_PE_CHECKPOINT=


# -------------------------------------------------------
# Object detection — RF-DETR (pinned production)
# -------------------------------------------------------
MVR_RFDETR_CHECKPOINT=


# -------------------------------------------------------
# ASR — Silero VAD + ChunkFormer
# -------------------------------------------------------
MVR_ASR_ALLOW_MODEL_DOWNLOAD=false


# -------------------------------------------------------
# Q&A — optional translation / Qwen models
# -------------------------------------------------------
MVR_QNA_MODEL=
MVR_QNA_ALLOW_MODEL_DOWNLOAD=false
MVR_TRAKE_TRANSLATE_QUERIES=false
MVR_TRAKE_ALLOW_MODEL_DOWNLOAD=false
MVR_TRAKE_TRANSLATION_MODEL=

# DeepL translation API key (only if using DeepL query translation).
DEEPL_API_KEY=


# -------------------------------------------------------
# HuggingFace / offline model cache
# -------------------------------------------------------
# Set to 1 when running offline after models are cached.
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=


# -------------------------------------------------------
# GPU deployment (docker compose)
# -------------------------------------------------------
GPU_IMAGE_TAG=latest
# Comma-separated GPU devices to expose, e.g. 0 or 0,1
NVIDIA_VISIBLE_DEVICES=all
